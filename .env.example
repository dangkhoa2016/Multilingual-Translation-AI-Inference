# Local development ONLY. Never commit real values.
TRANSLATION_INFERENCE_DATABASE_URL=sqlite+pysqlite:///./translation_inference_local.sqlite3
# For PostgreSQL deployment, replace the SQLite runtime URL above with a
# runtime PostgreSQL URL (pooled if offered, or direct).
# Alembic migrations need a DIRECT PostgreSQL URL to the SAME database.
# If the runtime URL is already direct, both variables may use that URL.
# Uncomment and replace ALL placeholders in your PRIVATE .env before migration.
# Migration URL is local to Alembic; do not put it in the Modal runtime Secret.
# TRANSLATION_INFERENCE_MIGRATION_DATABASE_URL='postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@DIRECT_HOST:5432/DB_NAME?sslmode=require'
TRANSLATION_API_BEARER_TOKEN=replace-with-a-random-local-token
# record-only / inline-mock / modal-cpu-mock / modal-gpu (real billable GPU)
# Initial Modal Secrets created by scripts/deployment/create_modal_secrets.py
# always use modal-cpu-mock. This inline-mock value is for local development.
# See docs/deployment.md and docs/deployment.vi.md for private .env setup.
TRANSLATION_DISPATCHER_MODE=inline-mock

# Durable database-backed submission and model-run limits (development defaults).
# TRANSLATION_MAX_JOBS_PER_MINUTE=10
# TRANSLATION_MAX_JOBS_PER_DAY=100
# TRANSLATION_MAX_MODEL_RUNS_PER_DAY=200
# TRANSLATION_MAX_ATTEMPTS_PER_MODEL=2

# Both optional estimated-dollar admission settings must be specified together.
# These are NOT actual provider-billing caps; no default spend is chosen.
# TRANSLATION_ESTIMATED_GPU_USD_PER_RUN=
# TRANSLATION_MAX_ESTIMATED_GPU_USD_PER_DAY=

# Request windows are per process; job polling/capacity share PostgreSQL.
# Configure the same database-backed limits on every replica.
# TRANSLATION_MAX_REQUESTS_PER_MINUTE_PER_PEER=120
# TRANSLATION_MAX_REQUESTS_PER_MINUTE_PER_PROCESS=600
# TRANSLATION_MAX_JOB_POLLS_PER_MINUTE=120
# TRANSLATION_MAX_PENDING_JOBS_PER_OWNER=20
# TRANSLATION_MAX_PENDING_RUNS_PER_MODEL=20
# Optional bounded access metadata; no tokens, bodies, UUIDs or IPs.
# TRANSLATION_AUDIT_LOG_ENABLED=false
